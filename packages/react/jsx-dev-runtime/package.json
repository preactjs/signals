{
  "name": "@preact/signals-react-jsx-dev-runtime",
  "description": "Sub package for @preact/signals-react that provides a development JSX runtime supporting signals on DOM attributes",
  "private": true,
  "amdName": "reactSignalsJsxDevRuntime",
  "main": "dist/jsx-dev-runtime.js",
  "module": "dist/jsx-dev-runtime.module.js",
  "unpkg": "dist/jsx-dev-runtime.min.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "mangle": "../../../mangle.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/jsx-dev-runtime.module.js",
      "import": "./dist/jsx-dev-runtime.mjs",
      "require": "./dist/jsx-dev-runtime.js"
    }
  },
  "peerDependencies": {
    "react": "^16.14.0 || 17.x || 18.x || 19.x"
  }
}
